<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vellum.Rotation</RootNamespace>
    <AssemblyName>Vellum.Rotation</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Vellum.Rotation</PackageId>
    <Description>Opt-in background DEK rotation for Vellum envelope encryption. A hosted service periodically rotates Data Encryption Keys whose active key is older than a configurable maximum age, with per-scope retry and exponential backoff inside each tick. A failed rotation always leaves the previous key active (fail-safe), and one scope failing never aborts the rotation of the others.</Description>
    <PackageTags>vellum;envelope-encryption;dek;kek;rotation;key-rotation;background-service;hosted-service</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vellum.Abstractions\Vellum.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vellum.Rotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
