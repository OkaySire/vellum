<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vellum.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Vellum.EntityFrameworkCore</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Vellum.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core-backed IEncryptionKeyStore for Vellum envelope encryption. Provider-agnostic at runtime — the consumer chooses SQL Server, PostgreSQL, SQLite, or any other EF Core provider. Enforces a one-active-key-per-scope invariant via a filtered unique index and handles creation races via DbUpdateException and winner re-read.</Description>
    <PackageTags>vellum;envelope-encryption;dek;kek;entity-framework-core;ef-core;key-store</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vellum.Abstractions\Vellum.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vellum.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
