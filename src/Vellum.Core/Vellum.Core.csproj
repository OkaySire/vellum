<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vellum</RootNamespace>
    <AssemblyName>Vellum.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Vellum.Core</PackageId>
    <Description>Core implementation of Vellum envelope encryption: DEK lifecycle management, AES-256-GCM payload encryption, and DI extensions. Requires a KEK provider (Vellum.Vault, Vellum.Static, etc.) and a key store (Vellum.EntityFrameworkCore, Vellum.InMemory, etc.).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vellum.Abstractions\Vellum.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
