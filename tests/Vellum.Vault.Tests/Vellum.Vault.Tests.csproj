<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vellum.Vault.Tests</RootNamespace>
    <AssemblyName>Vellum.Vault.Tests</AssemblyName>
    <!--
      CA1707: underscores in test method names are idiomatic xUnit (Given_When_Then).
      CA2007: test methods do not need ConfigureAwait — xUnit has no sync context.
      CA2000: test-local HttpClient / ServiceProvider lifetimes are managed by the test scope.
      CA1515: test fakes are public so they can be instantiated by multiple test files.
      CA1822: instance vs static is not meaningful on test helper methods.
      CA1002: test fake exposes List<T> intentionally for xUnit assertions.
      CA1812: NoopProvider is instantiated via DI resolution; analyzer can't see the reflection path.
      CA1849: cts.Cancel() in synchronous test arrangement is idiomatic — no perf concern.
    -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA2000;CA1515;CA1822;CA1002;CA1812;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vellum.Vault\Vellum.Vault.csproj" />
  </ItemGroup>

</Project>
