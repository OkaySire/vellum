<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
    THIS PROJECT MUST CONTAIN EXACTLY ONE TEST. DO NOT ADD A SECOND ONE.
    ============================================================================

    The whole point of this assembly is the ISOLATION of its single test.

    VellumDecryptMetrics is a static class: its class constructor — the thing that
    creates the Meter and publishes the instruments — runs AT MOST ONCE PER
    PROCESS. A dedicated test assembly gets its own test host process, so this
    test observes the metrics type in its pristine, never-touched state.

    Merge this test into Vellum.Core.Tests (or add any other test here that
    touches VellumDecryptMetrics, directly or through a decrypt) and it goes
    GREEN WITHOUT THE FIX: whichever test ran first would have triggered the
    class constructor, MeterListener.Start() would enumerate the
    already-published instruments, and the assertion would pass while the
    defect it guards against was fully back in place.

    A green result from this test means nothing unless it is alone in here.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vellum.Tests.MeterRegistration</RootNamespace>
    <AssemblyName>Vellum.Core.MeterRegistration.Tests</AssemblyName>
    <!--
      CA1707: underscores in test method names are idiomatic xUnit (Given_When_Then).
      CA2007: test methods do not need ConfigureAwait — xUnit has no sync context.
      CA2000: test-local ServiceProvider lifetimes are managed by the test scope.
      CA1515: test types are public so xUnit can discover them.
    -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA2000;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vellum.Core\Vellum.Core.csproj" />
  </ItemGroup>

</Project>
